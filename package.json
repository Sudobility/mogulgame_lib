{
  "name": "@sudobility/mogulgame_lib",
  "version": "0.0.40",
  "description": "Business logic library for Starter with Zustand stores",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src/",
    "lint:fix": "bunx eslint src/ --fix",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "format:check": "bunx prettier --check \"src/**/*.ts\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build"
  },
  "keywords": [
    "mogulgame",
    "business-logic",
    "zustand",
    "react",
    "typescript"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/mogulgame_client": "^0.0.42",
    "@sudobility/mogulgame_types": "^0.0.31",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/react": "~16.3.3",
    "@testing-library/react-hooks": "~8.0.1",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~17.13.0",
    "jsdom": "~30.1.3",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12",
    "zustand": "~5.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/mogulgame_lib.git"
  }
}
